---
import AboutSection from "@/components/home/AboutSection.astro";
import ExperienceSection from "@/components/home/ExperienceSection.astro";
import Footer from "@/components/home/Footer.astro";
import ProjectsSection from "@/components/home/ProjectsSection.astro";
import SkillsSection from "@/components/home/SkillsSection.astro";
import type { Locale } from "@/data/portfolio";

type Props = {
  data: typeof import("@/locales/en.json");
  lang: Locale;
};

const { data, lang } = Astro.props;
---

<section
  id="portfolio-grid-section"
  class="relative min-h-screen w-full scroll-smooth bg-(--background) lg:h-screen lg:w-1/2 lg:overflow-y-auto"
>
  <div id="grid-top-sentinel"></div>

  <AboutSection data={data} />
  <SkillsSection data={data} />
  <ExperienceSection data={data} />
  <ProjectsSection data={data} lang={lang} />
  <Footer data={data} />
</section>
