---
type PortfolioData = typeof import("@/locales/en.json");

type Props = {
  profile: PortfolioData["profile"];
};

const { profile } = Astro.props;
---

<div class="relative">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-20 opacity-0 transition-opacity duration-300" data-legal-scrim></div>
  <div class="pointer-events-none absolute inset-x-0 bottom-full z-25 flex justify-center px-4 md:px-6">
    <div id="legal-overlay-panel" class="pointer-events-auto w-full max-w-5xl translate-y-6 transform opacity-0 transition-all duration-500 ease-out" data-legal-panel>
      <div class="overflow-hidden rounded-t-[28px] border border-(--border) bg-(--card) text-(--foreground) shadow-2xl">
        <div class="flex items-center justify-between border-b border-(--border) bg-(--card) px-5 py-4 md:px-6">
          <button type="button" aria-label="Close legal panel" class="group flex items-center gap-2 transition-opacity hover:cursor-pointer hover:opacity-70" data-legal-close>
            <span class="flex h-5 w-5 scale-x-125 items-center justify-center text-[1.2rem] leading-none transition-transform duration-300 group-hover:translate-y-0.5 md:h-6 md:w-6">
              ⌄
            </span>
            <span class="text-[0.78rem] uppercase tracking-[0.08em] text-(--foreground)/70" data-legal-title>
              Impressum
            </span>
          </button>
        </div>
        <div class="max-h-[65vh] overflow-y-auto bg-(--card) px-5 py-5 md:px-6 md:py-6">
          <article class="mx-auto hidden w-full max-w-4xl px-6 py-8" data-legal-content="impressum">
            <h2 class="text-3xl font-semibold tracking-[-0.04em]">Impressum</h2>
            <div class="mt-6 space-y-4 text-(--foreground)/80">
              <p>Angaben gemäß § 5 TMG</p>
              <div>
                <div class="py-2 text-(--foreground)/80 md:py-4">
                  <p>{profile.firstname} {profile.lastname}</p>
                  <p>{profile.address.street} {profile.address.streetNumber}</p>
                  <p>{profile.address.zipcode} {profile.address.city}</p>
                  <p>{profile.address.country}</p>
                </div>
                <div class="py-2 text-(--foreground)/80 md:py-4">
                  <p>Kontakt</p>
                  <p>E-Mail: {profile.email}</p>
                  <p>Telefon: {profile.phone}</p>
                </div>
                <div class="py-2 text-(--foreground)/80 md:py-4">
                  <p>Verantwortlich für den Inhalt nach § 55 Abs. 2 RStV:</p>
                  <p>{profile.firstname} {profile.lastname}</p>
                  <p>{profile.address.street} {profile.address.streetNumber}</p>
                  <p>{profile.address.zipcode} {profile.address.city}</p>
                  <p>{profile.address.country}</p>
                </div>
                <div class="py-1 text-(--foreground)/80 md:py-2">
                  <p>Haftung für Inhalte</p>
                  <p>Die Inhalte unserer Seiten wurden mit größter Sorgfalt erstellt. Für die Richtigkeit, Vollständigkeit und Aktualität der Inhalte können wir jedoch keine Gewähr übernehmen.</p>
                </div>
                <div class="py-1 text-(--foreground)/80 md:py-2">
                  <p>Haftung für Links</p>
                  <p>Unser Angebot enthält Links zu externen Websites Dritter, auf deren Inhalte wir keinen Einfluss haben.</p>
                </div>
                <div class="py-1 text-(--foreground)/80 md:py-2">
                  <p>Urheberrecht</p>
                  <p>Die durch den Seitenbetreiber erstellten Inhalte und Werke auf diesen Seiten unterliegen dem Urheberrecht.</p>
                </div>
              </div>
            </div>
          </article>
          <section class="mx-auto hidden w-full max-w-4xl px-6" data-legal-content="privacy">
            <h2 class="text-3xl font-semibold tracking-[-0.04em]">Privacy</h2>
            <div class="mt-6 space-y-4 text-(--foreground)/80">
              <p>Datenschutzerklärung</p>
              <div>
                <div class="py-2 text-(--foreground)/80 md:py-4">
                  <h4 class="pb-0.5">1. Allgemeine Hinweise</h4>
                  <p>Diese Website dient der Präsentation eines persönlichen Portfolios. Der Schutz Ihrer persönlichen Daten ist uns wichtig.</p>
                </div>
                <div class="py-2 text-(--foreground)/80 md:py-4">
                  <h4 class="pb-0.5">2. Verantwortlicher</h4>
                  <p>{profile.firstname} {profile.lastname}</p>
                  <p>{profile.address.street} {profile.address.streetNumber}</p>
                  <p>{profile.address.zipcode} {profile.address.city}</p>
                  <p>{profile.address.country}</p>
                  <p class="pt-2">E-Mail: {profile.email}</p>
                </div>
                <div class="py-2 text-(--foreground)/80 md:py-4">
                  <h4 class="pb-0.5">3. Hosting</h4>
                  <p>Diese Website wird über Vercel Inc., 340 S Lemon Ave #4133, Walnut, CA 91789, USA gehostet.</p>
                  <p>Vercel verarbeitet personenbezogene Daten wie IP-Adressen zur Bereitstellung der Website. Dabei kann es zu einer Übertragung von Daten in die USA kommen.</p>
                  <p>Die Verarbeitung erfolgt auf Grundlage von Art. 6 Abs. 1 lit. f DSGVO.</p>
                </div>
                <div class="py-2 text-(--foreground)/80 md:py-4">
                  <h4 class="pb-0.5">4. Zugriffsdaten (Server-Logfiles)</h4>
                  <p>Beim Besuch dieser Website werden automatisch Informationen erfasst:</p>
                  <ul class="py-0.5 pl-5">
                    <li>- IP-Adresse</li>
                    <li>- Datum und Uhrzeit der Anfrage</li>
                    <li>- Browsertyp und Version</li>
                    <li>- Betriebssystem</li>
                  </ul>
                  <p>Diese Daten dienen der Sicherstellung eines störungsfreien Betriebs und der Sicherheit der Website.</p>
                </div>
                <div class="py-2 text-(--foreground)/80 md:py-4">
                  <h4 class="pb-0.5">5. Kontaktaufnahme</h4>
                  <p>Wenn Sie per E-Mail Kontakt aufnehmen, werden Ihre Angaben zur Bearbeitung Ihrer Anfrage gespeichert.</p>
                  <p>Die Verarbeitung erfolgt auf Grundlage von Art. 6 Abs. 1 lit. b DSGVO.</p>
                </div>
                <div class="py-2 text-(--foreground)/80 md:py-4">
                  <h4 class="pb-0.5">6. Cookies</h4>
                  <p>Diese Website verwendet keine Cookies zu Tracking-Zwecken.</p>
                </div>
                <div class="py-2 text-(--foreground)/80 md:py-4">
                  <h4 class="pb-0.5">7. Ihre Rechte</h4>
                  <p>Sie haben jederzeit das Recht auf:</p>
                  <ul class="py-0.5 pl-5">
                    <li>- Auskunft (Art. 15 DSGVO)</li>
                    <li>- Berichtigung (Art. 16 DSGVO)</li>
                    <li>- Löschung (Art. 17 DSGVO)</li>
                    <li>- Einschränkung der Verarbeitung (Art. 18 DSGVO)</li>
                    <li>- Datenübertragbarkeit (Art. 20 DSGVO)</li>
                    <li>- Widerspruch gegen die Verarbeitung (Art. 21 DSGVO)</li>
                  </ul>
                  <p>Zur Ausübung Ihrer Rechte kontaktieren Sie uns unter:</p>
                  <p>{profile.email}</p>
                </div>
                <div class="py-2 text-(--foreground)/80 md:py-4">
                  <h4 class="pb-0.5">8. Beschwerderecht bei der Aufsichtsbehörde</h4>
                  <p>Sie haben das Recht, sich bei einer Datenschutz-Aufsichtsbehörde zu beschweren.</p>
                </div>
                <div class="py-2 text-(--foreground)/80 md:py-4">
                  <p>Zuständige Behörde in Berlin:</p>
                  <p>Berliner Beauftragte für Datenschutz und Informationsfreiheit</p>
                  <p>Alt-Moabit 59-61</p>
                  <p>10555 Berlin</p>
                  <p>https://www.datenschutz-berlin.de/</p>
                </div>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </div>
  <footer id="footer" class="border-t border-(--border) bg-(--background) px-18 py-8">
    <div class="flex items-center justify-between">
      <span class="text-sm text-(--foreground)/70">© 2026 Lothaire</span>
      <div class="flex items-center gap-8">
        {["impressum", "privacy"].map((section) => (
          <button
            type="button"
            value={section}
            class="group relative flex items-center hover:cursor-pointer"
            aria-expanded="false"
            aria-controls="legal-overlay-panel"
            data-legal-trigger={section}
          >
            <span
              class="pointer-events-none absolute -top-6 left-1/2 h-5 w-5 -translate-x-1/2 translate-y-2 opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100"
              data-legal-chevron
            >
              ⌃
            </span>
            <span class="text-sm text-(--foreground)">{section}</span>
          </button>
        ))}
      </div>
    </div>
  </footer>
</div>

<script is:inline>
  (() => {
    const legalPanel = document.querySelector("[data-legal-panel]");
    const legalScrim = document.querySelector("[data-legal-scrim]");
    const legalTitle = document.querySelector("[data-legal-title]");
    let activeLegalSection = null;

    const setLegalSection = (section) => {
      activeLegalSection = activeLegalSection === section ? null : section;
      const isOpen = activeLegalSection !== null;
      legalPanel?.classList.toggle("translate-y-0", isOpen);
      legalPanel?.classList.toggle("opacity-100", isOpen);
      legalPanel?.classList.toggle("translate-y-6", !isOpen);
      legalPanel?.classList.toggle("opacity-0", !isOpen);
      legalScrim?.classList.toggle("pointer-events-none", !isOpen);
      legalScrim?.classList.toggle("opacity-0", !isOpen);
      legalScrim?.classList.toggle("opacity-100", isOpen);
      if (legalTitle) legalTitle.textContent = activeLegalSection === "privacy" ? "Privacy" : "Impressum";

      document.querySelectorAll("[data-legal-content]").forEach((content) => {
        content.classList.toggle("hidden", content.getAttribute("data-legal-content") !== activeLegalSection);
      });

      document.querySelectorAll("[data-legal-trigger]").forEach((button) => {
        const active = button.getAttribute("data-legal-trigger") === activeLegalSection;
        button.setAttribute("aria-expanded", String(active));
        button.querySelector("[data-legal-chevron]")?.classList.toggle("opacity-100", active);
        button.querySelector("[data-legal-chevron]")?.classList.toggle("translate-y-0", active);
        button.querySelector("[data-legal-chevron]")?.classList.toggle("opacity-0", !active);
        button.querySelector("[data-legal-chevron]")?.classList.toggle("translate-y-2", !active);
      });
    };

    document.querySelectorAll("[data-legal-trigger]").forEach((button) => {
      button.addEventListener("click", () => setLegalSection(button.getAttribute("data-legal-trigger")));
    });
    document.querySelector("[data-legal-close]")?.addEventListener("click", () => {
      activeLegalSection = null;
      setLegalSection(null);
    });
    legalScrim?.addEventListener("click", () => {
      activeLegalSection = null;
      setLegalSection(null);
    });
  })();
</script>
