---
import { getProjectPath, type Locale } from "@/data/portfolio";

type Props = {
  data: typeof import("@/locales/en.json");
  lang: Locale;
};

const { data, lang } = Astro.props;
const location = data.profile.locations.join(" - ");
const themeSelection = lang === "fr" ? "Thème" : "Theme";
const languageSelection =  lang === "fr" ? "Langue" : "Language";
const currentLanguageLabel = lang === "fr" ? "Français" : "English";
const phoneHref = data.profile.phone.replace(/\s/g, "");
---

<main
  class="flex min-h-screen w-full flex-col overflow-x-hidden bg-(--background) text-(--foreground) md:flex-row lg:h-screen lg:overflow-hidden"
>
  <section class="min-h-screen w-full lg:h-screen lg:w-1/2">
    <div
      id="portfolio-landing"
      class="mx-auto flex min-h-screen max-w-7xl flex-col justify-between px-6 py-8 sm:px-10 md:px-8 lg:h-screen lg:px-8"
    >
      <div class="flex justify-end">
        <div class="w-full max-w-4xl text-right leading-[0.88]">
          <h1
            class="text-[56px] font-black uppercase italic leading-[0.82] tracking-[-0.08em] sm:text-[72px] md:text-[96px] lg:text-[110px] xl:text-[132px] 2xl:text-[148px]"
          >
            <span class="block">{data.profile.firstname}</span>
            <span class="block">{data.profile.lastname}</span>
          </h1>
          <p class="text-[34px] font-semibold italic tracking-tighter sm:text-[48px] md:text-[56px]">
            {data.profile.profession}
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3" data-landing-controls>
        <div class="col-span-1 flex min-h-50 w-full items-center">
          <div class="w-full max-w-55 space-y-2">
            <div class="relative w-full border-b border-(--foreground)" data-settings-dropdown>
              <button type="button" class="flex w-full items-center justify-between gap-4 py-2 text-left">
                <!-- <span class="text-[0.85rem] tracking-[0.04rem] uppercase text-(--foreground)">Language</span> -->
                <span class="text-[0.85rem] tracking-[0.04rem] uppercase text-(--foreground)">{languageSelection}</span>
                <span class="flex items-center gap-3">
                  <span class="text-[1rem] tracking-[-0.04em] text-(--foreground)">{currentLanguageLabel}</span>
                  <span class="text-[1rem] transition-transform duration-200" data-dropdown-arrow>↓</span>
                </span>
              </button>
              <div
                class="grid grid-rows-[0fr] overflow-hidden opacity-0 transition-all duration-200 ease-out"
                data-dropdown-panel
              >
                <div class="overflow-hidden">
                  <div class="pb-2 pt-1">
                    <a
                      href="/fr/"
                      class="block py-1 text-left text-[0.95rem] tracking-[-0.03em] text-(--foreground)/72 transition-opacity duration-150 hover:opacity-60"
                    >
                      Français
                    </a>
                    <a
                      href="/"
                      class="block py-1 text-left text-[0.95rem] tracking-[-0.03em] text-(--foreground)/72 transition-opacity duration-150 hover:opacity-60"
                    >
                      English
                    </a>
                  </div>
                </div>
              </div>
            </div>

            <div class="relative w-full border-b border-(--foreground)" data-settings-dropdown>
              <button type="button" class="flex w-full items-center justify-between gap-4 py-2 text-left">
                <span class="text-[0.85rem] tracking-[0.04rem] uppercase text-(--foreground)">{themeSelection}</span>
                <span class="flex items-center gap-3">
                  <span class="text-[1rem] tracking-[-0.04em] text-(--foreground)" data-theme-label>Light</span>
                  <span class="text-[1rem] transition-transform duration-200" data-dropdown-arrow>↓</span>
                </span>
              </button>
              <div
                class="grid grid-rows-[0fr] overflow-hidden opacity-0 transition-all duration-200 ease-out"
                data-dropdown-panel
              >
                <div class="overflow-hidden">
                  <div class="pb-2 pt-1">
                    <button
                      type="button"
                      data-theme-choice="light"
                      class="block py-1 text-left text-[0.95rem] tracking-[-0.03em] text-(--foreground)/72 transition-opacity duration-150 hover:cursor-pointer hover:opacity-60"
                    >
                      Light
                    </button>
                    <button
                      type="button"
                      data-theme-choice="dark"
                      class="block py-1 text-left text-[0.95rem] tracking-[-0.03em] text-(--foreground)/72 transition-opacity duration-150 hover:cursor-pointer hover:opacity-60"
                    >
                      Dark
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-span-1 flex min-h-50 w-full items-center justify-end md:col-span-2">
          <nav class="max-w-4xl text-right leading-[0.88]" aria-label="Main navigation">
            <ul>
              <li class="mt-2 text-[32px] font-medium italic tracking-tighter md:text-[40px]">
                <button
                  type="button"
                  data-scroll-target="about"
                  class="group relative inline-block text-[24px] font-medium italic tracking-tighter transition-all duration-200 hover:cursor-pointer hover:opacity-70 active:opacity-50 sm:text-[32px] md:text-[40px]"
                >
                  {data.nav.about}
                  <span class="absolute -bottom-1 right-0 h-1 w-0 bg-current transition-all duration-300 ease-out group-hover:w-full group-focus-visible:w-full"></span>
                </button>
              </li>
              <li class="mt-2 text-[32px] font-medium italic tracking-tighter md:text-[40px]">
                <button
                  type="button"
                  data-scroll-target="skills"
                  class="group relative inline-block text-[24px] font-medium italic tracking-tighter transition-all duration-200 hover:cursor-pointer hover:opacity-70 active:opacity-50 sm:text-[32px] md:text-[40px]"
                >
                  {data.nav.skills}
                  <span class="absolute -bottom-1 right-0 h-1 w-0 bg-current transition-all duration-300 ease-out group-hover:w-full group-focus-visible:w-full"></span>
                </button>
              </li>
              <li class="mt-2 text-[32px] font-medium italic tracking-tighter md:text-[40px]">
                <button
                  type="button"
                  data-scroll-target="experience"
                  class="group relative inline-block text-[24px] font-medium italic tracking-tighter transition-all duration-200 hover:cursor-pointer hover:opacity-70 active:opacity-50 sm:text-[32px] md:text-[40px]"
                >
                  {data.nav.experience}
                  <span class="absolute -bottom-1 right-0 h-1 w-0 bg-current transition-all duration-300 ease-out group-hover:w-full group-focus-visible:w-full"></span>
                </button>
              </li>
              <li class="mt-2 text-[32px] font-medium italic tracking-tighter md:text-[40px]">
                <button
                  type="button"
                  data-scroll-target="projects"
                  class="group relative inline-block text-[24px] font-medium italic tracking-tighter transition-all duration-200 hover:cursor-pointer hover:opacity-70 active:opacity-50 sm:text-[32px] md:text-[40px]"
                >
                  {data.nav.projects}
                  <span class="absolute -bottom-1 right-0 h-1 w-0 bg-current transition-all duration-300 ease-out group-hover:w-full group-focus-visible:w-full"></span>
                </button>
              </li>
            </ul>
          </nav>
        </div>
      </div>

      <div class="flex flex-col justify-between gap-6 pt-8 md:flex-row md:items-end">
        <div class="max-w-fit border border-current px-3 py-2 text-[13px] uppercase tracking-tight sm:text-[15px]">
          <span class="block">{data.landing.locationLabel}</span>
          <span class="block">{location}</span>
        </div>

        <address class="w-full text-right not-italic leading-none md:w-fit">
          <button type="button" data-copy-phone={phoneHref} class="hover:cursor-pointer">
            <span class="group relative inline-flex">
              <span class="text-[36px] font-black tracking-[-0.07em] md:text-[56px] 2xl:text-[72px]">
                {data.profile.phone}
              </span>
              <span
                class="pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 translate-y-0 whitespace-nowrap border border-(--foreground)/10 bg-(--foreground)/90 px-2 py-1 text-[11px] uppercase tracking-[0.04em] text-(--background) opacity-0 backdrop-blur-sm transition-all duration-200 group-hover:opacity-100"
                data-phone-hover
              >
                {data.landing.phoneCta}
              </span>
              <span
                aria-live="polite"
                class="pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 translate-y-1 whitespace-nowrap border border-(--foreground)/10 bg-(--foreground)/90 px-2 py-1 text-[11px] uppercase tracking-[0.04em] text-(--background) opacity-0 backdrop-blur-sm transition-all duration-300"
                data-phone-active
              >
                {data.landing.phoneCopied}
              </span>
            </span>
          </button>
          <a href={`mailto:${data.profile.email}`} class="block transition-opacity hover:opacity-70" data-email-link>
            <span class="group relative inline-flex">
              <span class="text-[28px] font-semibold tracking-tighter sm:text-[36px] md:text-[42px] 2xl:text-[56px]">
                {data.profile.email}
              </span>
              <span
                class="pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 translate-y-0 whitespace-nowrap border border-(--foreground)/10 bg-(--foreground)/90 px-2 py-1 text-[11px] uppercase tracking-[0.04em] text-(--background) opacity-0 backdrop-blur-sm transition-all duration-200 group-hover:opacity-100"
                data-email-hover
              >
                {data.landing.emailCta}
              </span>
              <span
                aria-live="polite"
                class="pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 translate-y-1 whitespace-nowrap border border-(--foreground)/10 bg-(--foreground)/90 px-2 py-1 text-[11px] uppercase tracking-[0.04em] text-(--background) opacity-0 backdrop-blur-sm transition-all duration-300"
                data-email-active
              >
                {data.landing.emailOpened}
              </span>
            </span>
          </a>
          <!--
          <a href={`tel:${phoneHref}`} class="block transition-opacity hover:opacity-70">
            <span class="text-[36px] font-black tracking-[-0.07em] md:text-[56px] 2xl:text-[72px]">
              {data.profile.phone}
            </span>
          </a>
          <a href={`mailto:${data.profile.email}`} class="block transition-opacity hover:opacity-70">
            <span class="text-[28px] font-semibold tracking-tighter sm:text-[36px] md:text-[42px] 2xl:text-[56px]">
              {data.profile.email}
            </span>
          </a>
          -->
        </address>
      </div>
    </div>
  </section>

  <section
    id="portfolio-grid-section"
    class="relative min-h-screen w-full scroll-smooth bg-(--background) lg:h-screen lg:w-1/2 lg:overflow-y-auto"
  >
    <div id="grid-top-sentinel"></div>

  <section id="about" class="min-h-screen bg-(--background) text-(--foreground)">
    <div class="mx-auto w-full max-w-350 px-6 py-6 sm:px-8 md:px-10 lg:px-12 xl:px-16">
      <div class="flex flex-col justify-between gap-8">
        <h2 class="text-[2rem] leading-[0.97] tracking-[-0.06em] md:text-[3rem] lg:text-[3.5rem] 2xl:text-[3.8rem]">
          {data.about.intro}
        </h2>
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,0.9fr)] lg:gap-14">
          <div class="overflow-hidden">
            <div class="md:max-h-110 lg:max-h-130 xl:max-h-145 2xl:max-h-160">
              <img
                src={data.profile.portrait.src}
                alt={data.profile.portrait.alt}
                width="600"
                height="850"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover"
                data-portrait-image
              />
            </div>
          </div>
          <div class="my-auto flex flex-col justify-between gap-10">
            <div class="space-y-5">
              <p class="max-w-[42ch] text-[15px] leading-[1.28] tracking-[-0.03em] text-(--foreground)/85 2xl:text-[18px]">
                {data.about.sideText1}
              </p>
              <p class="max-w-[42ch] text-[15px] leading-[1.28] tracking-[-0.03em] text-(--foreground)/85 2xl:text-[18px]">
                {data.about.sideText2}
              </p>
              <p class="max-w-[42ch] text-[15px] leading-[1.28] tracking-[-0.03em] text-(--foreground)/85 2xl:text-[18px]">
                {data.about.sideText3}
              </p>
            </div>
          </div>
        </div>
        <p class="text-[1.9rem] italic leading-[0.97] tracking-[-0.06em] sm:text-[2rem]">{data.about.closing}</p>
        <div class="hidden justify-center transition-all duration-700 md:flex" data-about-scroll-cta>
          <button
            type="button"
            data-scroll-target="skills"
            class="group flex h-10 w-10 items-center justify-center transition-opacity duration-200 hover:cursor-pointer hover:opacity-70"
            aria-label={data.mobileNav.skills}
          >
            <span class="scale-x-125 text-[1.6rem] leading-none text-(--foreground) transition-transform duration-300 group-hover:translate-y-1">
              ⌄
            </span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <section id="skills" class="bg-(--background) text-(--foreground)">
    <div class="mx-auto min-h-screen w-full max-w-350 px-6 py-8 sm:px-8 md:px-10 lg:px-12 xl:px-16">
      <div class="flex flex-col gap-8 border-t border-(--foreground)/15 lg:gap-10">
        <div class="mx-auto w-full max-w-400 py-4 md:pt-8">
          <h2 class="text-[2.5rem] font-black uppercase leading-[0.97] tracking-[-0.02em] xl:text-[3.4rem] 2xl:text-[4rem]">
            {data.skillsAndExpertise.title}
          </h2>
        </div>
        <p class="text-[2rem] leading-[0.97] tracking-[-0.06em] md:text-[3rem] lg:text-[3.8rem]">
          {data.skillsAndExpertise.intro}
        </p>
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-[120px_minmax(0,1fr)] lg:gap-x-12">
          <p class="pt-0 text-center text-[0.85rem] uppercase tracking-[0.04em] text-(--foreground)/60 md:pt-3 md:text-left">
            {data.skillsAndExpertise.stackLabel}
          </p>
          <div class="grid grid-cols-2 gap-x-10 gap-y-12 md:grid-cols-4">
            {
              [
                data.skills.frontend,
                data.skills.backend,
                data.skills.programmingLanguages,
                data.skills.tools,
              ].map((category) => (
                <div class="border-t border-(--foreground)/15 pt-4">
                  <h3 class="mb-4 text-[1.1rem] font-medium leading-none tracking-[-0.04em]">
                    {category.label}
                  </h3>
                  <ul class="space-y-1.5">
                    {category.items.map((item) => (
                      <li class="text-[15px] leading-[1.2] tracking-[-0.03em] text-(--foreground)/85">
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-[120px_minmax(0,1fr)] lg:gap-x-12">
          <p class="pt-0 text-center text-[0.85rem] uppercase tracking-[0.04em] text-(--foreground)/60 md:pt-3 md:text-left">
            {data.expertise.stackLabel}
          </p>
          <div>
            <div class="border-t border-(--foreground)/15 pt-4">
              <ul class="space-y-1.5">
                {data.expertise.items.map((item) => (
                  <li class="text-[15px] leading-[1.2] tracking-[-0.03em] text-(--foreground)/85">{item}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="experience" class="bg-(--background) text-(--foreground)">
    <div class="mx-auto min-h-screen w-full max-w-350 px-6 py-8 sm:px-8 md:px-10 lg:px-12 xl:px-16">
      <div class="mx-auto w-full max-w-400 border-t border-(--foreground)/15 py-4 md:pt-8">
        <h2 class="text-[2.5rem] font-black uppercase leading-[0.97] tracking-[-0.02em] xl:text-[3.4rem] 2xl:text-[4rem]">
          {data.experience.title}
        </h2>
      </div>
      <div class="mx-auto w-full max-w-400 py-8">
        <div class="space-y-14">
          {
            data.experience.experienceList.map((item, index) => (
              <article class={`${index === 0 ? "" : "border-t border-(--foreground)/20"} pt-5`}>
                <div class="grid grid-cols-1 gap-6 lg:grid-cols-3 lg:gap-8">
                  <div class="col-span-1 space-y-3">
                    <p class="text-[15px] leading-[1.1] tracking-[-0.03em] text-(--foreground)/70">{item.period}</p>
                    <div class="leading-none">
                      <h3 class="text-[1.8rem] font-medium tracking-[-0.06em] sm:text-[2.2rem]">{item.role}</h3>
                      {item.company && <p class="mt-1 text-[1.1rem] tracking-[-0.04em] text-(--foreground)/85">{item.company}</p>}
                      {item.location && <p class="mt-1 text-[15px] tracking-[-0.03em] text-(--foreground)/60">{item.location}</p>}
                    </div>
                  </div>
                  <div class="grid grid-cols-1 gap-8 lg:col-span-2 lg:grid-cols-3">
                    <div class="col-span-1 space-y-5 xl:col-span-2">
                      <p class="max-w-full text-[15px] leading-[1.28] tracking-[-0.03em] text-(--foreground)/85 md:max-w-54 lg:max-w-60 2xl:max-w-65">
                        {item.summary}
                      </p>
                      <ul class="max-w-full space-y-1.5 md:max-w-54 lg:max-w-60 2xl:max-w-65">
                        {item.missions.map((mission) => (
                          <li class="text-[15px] leading-[1.2] tracking-[-0.03em] text-(--foreground)/75">{mission}</li>
                        ))}
                      </ul>
                    </div>
                    <div class="space-y-3">
                      <p class="text-[13px] uppercase tracking-[0.04em] text-(--foreground)/50">{data.experience.stackLabel}</p>
                      <ul class="flex flex-wrap gap-1.5 pt-0.5 md:flex-col md:space-y-1.5">
                        {item.stack.map((tech) => (
                          <li class="text-[15px] leading-[1.2] tracking-[-0.03em] text-(--foreground)/85">{tech}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section id="projects" class="bg-(--background) text-(--foreground)">
    <div class="mx-auto min-h-screen w-full max-w-350 px-6 py-8 sm:px-8 md:px-10 lg:px-12 xl:px-16">
      <div class="mx-auto w-full max-w-400 border-t border-(--foreground)/15 py-4 md:pt-8">
        <h2 class="text-[2.5rem] font-black uppercase leading-[0.97] tracking-[-0.02em] xl:text-[3.4rem] 2xl:text-[4rem]">
          {data.projects.title}
        </h2>
      </div>
      <div class="mx-auto w-full max-w-400 py-8">
        <div class="space-y-20 md:space-y-28">
          {
            data.projects.projectList.map((project, index) => (
              <article
                id={`project_${project.slug}`}
                class={`${index === 0 ? "" : "border-t border-(--foreground)/20"} pt-5`}
                data-project-preview
                data-project-images={JSON.stringify(project.gallery)}
              >
                <div class={`grid grid-cols-1 gap-8 md:grid-cols-5 lg:gap-10 xl:gap-10 ${project.layout === "image-right" ? "lg:[&>*:first-child]:order-2 lg:[&>*:last-child]:order-1" : ""}`}>
                  <div class="col-span-1 space-y-4 gap-10 md:col-span-3 md:space-y-10">
                    <button
                      type="button"
                      class="aspect-5/3 overflow-hidden bg-(--foreground)/5 shadow-lg hover:cursor-zoom-in"
                      data-project-preview-open
                    >
                      <img
                        src={project.mainImage.src}
                        alt={project.mainImage.alt}
                        loading="lazy"
                        decoding="async"
                        class="w-full object-cover"
                        data-project-preview-main
                      />
                    </button>

                    <div class="grid grid-cols-4 gap-1 border-t border-(--foreground)/15 pt-5 md:pt-10 xl:grid-cols-2">
                      {project.gallery.map((image, imageIndex) => (
                        <button
                          type="button"
                          data-project-thumb={imageIndex}
                          class={`flex w-full items-center justify-center overflow-hidden shadow-md transition-opacity hover:cursor-pointer hover:opacity-70 ${image.src === project.mainImage.src ? "border-(--foreground)" : "border-(--foreground)/15"}`}
                        >
                          <img
                            src={image.src}
                            alt={image.alt}
                            loading="lazy"
                            decoding="async"
                            class="aspect-5/3 w-full object-contain"
                          />
                        </button>
                      ))}
                    </div>

                    <div class="flex gap-4 px-2 py-0 md:px-4 md:py-2">
                      {project.links.live && (
                        <a
                          href={project.links.live}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="group relative inline-block text-[24px] font-medium italic tracking-tighter transition-all duration-200 hover:opacity-70 active:opacity-50 sm:text-[32px] md:text-[40px]"
                        >
                          {data.projects.linkLabels.live}
                          <span class="absolute -bottom-1 right-0 h-1 w-0 bg-current transition-all duration-300 ease-out group-hover:w-full group-focus-visible:w-full"></span>
                        </a>
                      )}
                      {project.links.github && (
                        <a
                          href={project.links.github}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="group relative inline-block text-[24px] font-medium italic tracking-tighter transition-all duration-200 hover:opacity-70 active:opacity-50 sm:text-[32px] md:text-[40px]"
                        >
                          {data.projects.linkLabels.github}
                          <span class="absolute -bottom-1 right-0 h-1 w-0 bg-current transition-all duration-300 ease-out group-hover:w-full group-focus-visible:w-full"></span>
                        </a>
                      )}
                    </div>
                  </div>
                  <div class="grid gap-2 sm:grid-cols-1 md:col-span-2 md:grid-cols-5 md:gap-2.5 xl:gap-3.5 2xl:grid-cols-7">
                    <div class="space-y-5 sm:col-span-1 md:col-span-2 lg:col-span-3 xl:col-span-5 2xl:col-span-5">
                      <div class="space-y-2">
                        <p class="text-[13px] uppercase tracking-[0.04em] text-(--foreground)/50">{project.period}</p>
                        <h3 class="max-w-[12ch] text-[2.2rem] font-medium leading-[0.95] tracking-[-0.07em] sm:text-[2.8rem] lg:text-[3.4rem]">
                          <a href={getProjectPath(lang, project.slug)}>{project.title}</a>
                        </h3>
                        <p class="text-[15px] leading-[1.2] tracking-[-0.03em] text-(--foreground)/75">{project.role}</p>
                      </div>
                      <p class="max-w-[40ch] text-[1.1rem] leading-[1.05] tracking-tighter">{project.summary}</p>
                      <div class="space-y-3">
                        {project.description.map((paragraph) => (
                          <p class="max-w-[58ch] text-[15px] leading-[1.28] tracking-[-0.03em] text-(--foreground)/80">{paragraph}</p>
                        ))}
                      </div>
                    </div>
                    <div class="space-y-3 pt-2 sm:col-span-1 xl:col-span-5 2xl:col-span-2 2xl:pt-0">
                      <p class="text-[13px] uppercase tracking-[0.04em] text-(--foreground)/50">{data.experience.stackLabel}</p>
